From 6274535e1a8027ecc310aec4004b5107e1be97cb Mon Sep 17 00:00:00 2001
From: Jackie Han <jackie.han@gmail.com>
Date: Thu, 26 Nov 2026 07:19:18 +0800
Subject: [PATCH] Refactor script extraction in background playback tests

Update script extraction logic and add assertion for script block presence.
---
 tests/background-playback.test.js | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/tests/background-playback.test.js b/tests/background-playback.test.js
index f249824..ba977b0 100644
--- a/tests/background-playback.test.js
+++ b/tests/background-playback.test.js
@@ -4,7 +4,9 @@ const fs = require('node:fs');
 const path = require('node:path');
 const test = require('node:test');
 const template = fs.readFileSync(path.join(__dirname, '../ucode/template/themes/argon/login_background.ut'), 'utf8');
-const script = template.match(/<script>([\s\S]*?)<\/script>/)[1];
+const scriptMatch = template.match(/<script\b[^>]*>([\s\S]*?)<\/script\s*>/i);
+assert.ok(scriptMatch, 'login_background.ut must contain a <script> block');
+const script = scriptMatch[1];
 function fixture(reduced = false, blocked = false) {
  const video = Object.assign(new EventTarget(), { paused: true, muted: true,
   play() { if (blocked) return Promise.reject(Error('blocked'));this.paused = false;this.dispatchEvent(new Event('play'));return Promise.resolve(); },
