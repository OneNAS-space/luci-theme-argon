From 2c7254bde94bb6dcb7690a9b7b45244996fe9ee8 Mon Sep 17 00:00:00 2001
From: Jackie Han <jackie.han@gmail.com>
Date: Thu, 29 Oct 2026 07:16:40 +0800
Subject: [PATCH] Align single-choice dropdown inner spacing with native select

cbi-dropdown/Combobox put an extra .25em before the label and .25rem after the
arrow, so the text sits ~3.5px further in and the chevron ~4px further from the
border than in a native select (13px / 17px). Remove both extras for
single-choice dropdowns so Group Name-style comboboxes line up with Type,
Protocol and the other selects.
---
 less/components/lists.less | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/less/components/lists.less b/less/components/lists.less
index 838a6bf..ba40396 100644
--- a/less/components/lists.less
+++ b/less/components/lists.less
@@ -200,6 +200,17 @@
   align-items: center;
 }
 
+// Single-choice dropdowns and Comboboxes: use the same inner spacing as a
+// native select (12px text inset, chevron centred 16px from the padding edge),
+// instead of the extra .25em on the label and .25rem after the arrow.
+.cbi-dropdown:not([multiple]):not(.btn):not(.cbi-button) {
+  padding-inline-end: 0;
+
+  > ul:not(.dropdown) > li {
+    padding-inline-start: 0;
+  }
+}
+
 .cbi-dropdown.btn>ul:not(.dropdown),
 .cbi-dropdown.cbi-button>ul:not(.dropdown) {
   margin: 0 0.75rem;
-- 
